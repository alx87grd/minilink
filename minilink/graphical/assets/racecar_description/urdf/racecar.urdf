<?xml version="1.0"?>
<robot name="racecar">
  <material name="Black">
    <color rgba="0.0 0.0 0.0 1.0" />
  </material>
  <material name="Blue">
    <color rgba="0.0 0.0 0.8 1.0" />
  </material>
  <material name="Green">
    <color rgba="0.0 0.8 0.0 1.0" />
  </material>
  <material name="DarkGrey">
    <color rgba="0.8 0.8 0.8 1.0" />
  </material>
  <material name="Orange">
    <color rgba="1 0.423529 0.0392157 1.0" />
  </material>
  <material name="Red">
    <color rgba="0.8 0.0 0.0 1.0" />
  </material>
  <material name="White">
    <color rgba="1.0 1.0 1.0 1.0" />
  </material>
  <material name="Yellow">
    <color rgba="0.8 0.8 0.0 1.0" />
  </material>
  <material name="Turquoise">
    <color rgba="0.0 0.8 0.8 1.0" />
  </material>
  <material name="SkyBlue">
    <color rgba="0.13 0.44 0.70 1.0" />
  </material>
  <material name="Indigo">
    <color rgba="0.33 0 0.5 1.0" />
  </material>
  <link name="racecar/base_footprint" />
  <link name="racecar/base_link" />
  <joint name="base_footprint_link_joint" type="fixed">
    <origin xyz="0 0 0.05" rpy="0 0 0" />
    <parent link="racecar/base_footprint" />
    <child link="racecar/base_link" />
  </joint>
  <link name="racecar/chassis">
    <visual>
      <origin xyz="0 0 0.05" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://racecar_description/meshes/chassis.STL" />
      </geometry>
      <material name="Blue" />
    </visual>
    <collision>
      <geometry>
        <box size=".3 .1 .05" />
      </geometry>
    </collision>
  </link>
  <joint name="base_link_joint" type="fixed">
    <origin xyz="0 0 0.0" rpy="0 0 0" />
    <parent link="racecar/base_link" />
    <child link="racecar/chassis" />
  </joint>
  <link name="racecar/chassis_inertia">
    <inertial>
      <origin xyz="0.1477 0 0" rpy="0 0 0" />
      <mass value="4.0" />
      <inertia ixx="0.010609" ixy="0" ixz="0" iyy="0.050409" iyz="0" izz="0.05865" />
    </inertial>
  </link>
  <joint name="chassis_inertia_joint" type="fixed">
    <origin xyz="0 0 0" rpy="0 0 0" />
    <parent link="racecar/chassis" />
    <child link="racecar/chassis_inertia" />
  </joint>
  <link name="racecar/left_rear_wheel">
    <inertial>
      <origin xyz="0 0 -0.0225" rpy="0 0 0" />
      <mass value="0.34055" />
      <inertia ixx="0.00026046" ixy="0" ixz="0" iyy="0.00026046" iyz="0" izz="0.00041226" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://racecar_description/meshes/left_rear_wheel.STL" />
      </geometry>
      <material name="Black" />
    </visual>
    <collision>robot
      <origin xyz="0 0 -0.0225" rpy="0 0 0" />
      <geometry>
        <cylinder length="0.045" radius="0.05" />
      </geometry>
    </collision>
  </link>
  <joint name="left_rear_wheel_joint" type="continuous">
    <origin xyz="0 0.1 0" rpy="1.5708 0 0" />
    <parent link="racecar/chassis" />
    <child link="racecar/left_rear_wheel" />
    <axis xyz="0 0 -1" />
    <limit effort="20" velocity="100" />
  </joint>
  <transmission name="left_rear_wheel_transmission" type="SimpleTransmission">
    <type>transmission_interface/SimpleTransmission</type>
    <joint name="left_rear_wheel_joint">
      <hardwareInterface>EffortJointInterface</hardwareInterface>
    </joint>
    <actuator name="left_rear_wheel_motor">
      <hardwareInterface>EffortJointInterface</hardwareInterface>
      <mechanicalReduction>1</mechanicalReduction>
    </actuator>
  </transmission>
  <link name="racecar/right_rear_wheel">
    <inertial>
      <origin xyz="0 0 0.0225" rpy="0 0 0" />
      <mass value="0.34055" />
      <inertia ixx="0.00026046" ixy="0" ixz="0" iyy="0.00026046" iyz="0" izz="0.00041226" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://racecar_description/meshes/right_rear_wheel.STL" />
      </geometry>
      <material name="Black" />
    </visual>
    <collision>
      <origin xyz="0 0 0.0225" rpy="0 0 0" />
      <geometry>
        <cylinder length="0.045" radius="0.05" />
      </geometry>
    </collision>
  </link>
  <joint name="right_rear_wheel_joint" type="continuous">
    <origin xyz="0 -0.1 0" rpy="1.5708 0 0" />
    <parent link="racecar/chassis" />
    <child link="racecar/right_rear_wheel" />
    <axis xyz="0 0 -1" />
    <limit effort="20" velocity="100" />
  </joint>
  <transmission name="right_rear_wheel_transmission" type="SimpleTransmission">
    <type>transmission_interface/SimpleTransmission</type>
    <joint name="right_rear_wheel_joint">
      <hardwareInterface>EffortJointInterface</hardwareInterface>
    </joint>
    <actuator name="right_rear_wheel_motor">
      <hardwareInterface>EffortJointInterface</hardwareInterface>
      <mechanicalReduction>1</mechanicalReduction>
    </actuator>
  </transmission>
  <link name="racecar/left_steering_hinge">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <mass value="0.100" />
      <inertia ixx="4E-06" ixy="0" ixz="0" iyy="4E-06" iyz="0" izz="4E-06" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://racecar_description/meshes/left_steering_hinge.STL" />
      </geometry>
      <material name="DarkGrey" />
    </visual>
  </link>
  <joint name="left_steering_hinge_joint" type="revolute">
    <origin xyz="0.34 0.1 0" rpy="0 1.5708 0" />
    <parent link="racecar/chassis" />
    <child link="racecar/left_steering_hinge" />
    <axis xyz="-1 0 0" />
    <limit lower="-1.0" upper="1.0" effort="10" velocity="100" />
  </joint>
  <transmission name="left_steering_hinge_transmission" type="SimpleTransmission">
    <type>transmission_interface/SimpleTransmission</type>
    <joint name="left_steering_hinge_joint">
      <hardwareInterface>EffortJointInterface</hardwareInterface>
    </joint>
    <actuator name="left_steering_hinge_motor">
      <hardwareInterface>EffortJointInterface</hardwareInterface>
      <mechanicalReduction>1</mechanicalReduction>
    </actuator>
  </transmission>
  <link name="racecar/right_steering_hinge">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <mass value="0.100" />
      <inertia ixx="4E-06" ixy="0" ixz="0" iyy="4E-06" iyz="0" izz="4E-06" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://racecar_description/meshes/right_steering_hinge.STL" />
      </geometry>
      <material name="DarkGrey" />
    </visual>
  </link>
  <joint name="right_steering_hinge_joint" type="revolute">
    <origin xyz="0.34 -0.1 0" rpy="0 1.5708 0" />
    <parent link="racecar/chassis" />
    <child link="racecar/right_steering_hinge" />
    <axis xyz="-1 0 0" />
    <limit lower="-1.0" upper="1.0" effort="10" velocity="100" />
  </joint>
  <transmission name="right_steering_hinge_transmission" type="SimpleTransmission">
    <type>transmission_interface/SimpleTransmission</type>
    <joint name="right_steering_hinge_joint">
      <hardwareInterface>EffortJointInterface</hardwareInterface>
    </joint>
    <actuator name="right_steering_hinge_motor">
      <hardwareInterface>EffortJointInterface</hardwareInterface>
      <mechanicalReduction>1</mechanicalReduction>
    </actuator>
  </transmission>
  <link name="racecar/left_front_wheel">
    <inertial>
      <origin xyz="0 0 -0.0225" rpy="0 0 0" />
      <mass value="0.34055" />
      <inertia ixx="0.00026046" ixy="0" ixz="0" iyy="0.00026046" iyz="0" izz="0.00041226" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://racecar_description/meshes/left_front_wheel.STL" />
      </geometry>
      <material name="Black" />
    </visual>
    <collision>
      <origin xyz="0 0 -0.0225" rpy="0 0 0" />
      <geometry>
        <cylinder length="0.045" radius="0.05" />
      </geometry>
    </collision>
  </link>
  <joint name="left_front_wheel_joint" type="continuous">
    <origin xyz="0 0 0" rpy="1.5708 0 0" />
    <parent link="racecar/left_steering_hinge" />
    <child link="racecar/left_front_wheel" />
    <axis xyz="0 0 -1" />
    <limit effort="20" velocity="100" />
  </joint>
  <transmission name="left_front_wheel_transmission" type="SimpleTransmission">
    <type>transmission_interface/SimpleTransmission</type>
    <joint name="left_front_wheel_joint">
      <hardwareInterface>EffortJointInterface</hardwareInterface>
    </joint>
    <actuator name="left_front_wheel_motor">
      <hardwareInterface>EffortJointInterface</hardwareInterface>
      <mechanicalReduction>1</mechanicalReduction>
    </actuator>
  </transmission>
  <link name="racecar/right_front_wheel">
    <inertial>
      <origin xyz="0 0 0.0225" rpy="0 0 0" />
      <mass value="0.34055" />
      <inertia ixx="0.00026046" ixy="0" ixz="0" iyy="0.00026046" iyz="0" izz="0.00041226" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://racecar_description/meshes/right_front_wheel.STL" />
      </geometry>
      <material name="Black" />
    </visual>
    <collision>
      <origin xyz="0 0 0.0225" rpy="0 0 0" />
      <geometry>
        <cylinder length="0.045" radius="0.05" />
      </geometry>
    </collision>
  </link>
  <joint name="right_front_wheel_joint" type="continuous">
    <origin xyz="0 0 0" rpy="1.5708 0 0" />
    <parent link="racecar/right_steering_hinge" />
    <child link="racecar/right_front_wheel" />
    <axis xyz="0 0 -1" />
    <limit effort="20" velocity="100" />
  </joint>
  <transmission name="right_front_wheel_transmission" type="SimpleTransmission">
    <type>transmission_interface/SimpleTransmission</type>
    <joint name="right_front_wheel_joint">
      <hardwareInterface>EffortJointInterface</hardwareInterface>
    </joint>
    <actuator name="right_front_wheel_motor">
      <hardwareInterface>EffortJointInterface</hardwareInterface>
      <mechanicalReduction>1</mechanicalReduction>
    </actuator>
  </transmission>
  <link name="racecar/base_laser">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <mass value="0.130" />
      <inertia ixx="4E-06" ixy="0" ixz="0" iyy="4E-06" iyz="0" izz="4E-06" />
    </inertial>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <box size="0.1 0.1 0.1" />
      </geometry>
    </collision>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://racecar_description/meshes/hokuyo.dae" />
        <material name="DarkGrey" />
      </geometry>
    </visual>
  </link>
  <joint name="hokuyo_joint" type="fixed">
    <origin xyz="0.1387 0.0 0.166" rpy="0 0 3.14159" />
    <parent link="racecar/chassis" />
    <child link="racecar/base_laser" />
    <axis xyz="0 0 1" />
  </joint>
  <link name="racecar/camera_link">
    <inertial>
      <mass value="1e-5" />
      <origin xyz="0 0 0" rpy="0 0 0" />
      <inertia ixx="1e-6" ixy="0" ixz="0" iyy="1e-6" iyz="0" izz="1e-6" />
    </inertial>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <box size="0.033 0.03 0.030" />
      </geometry>
    </collision>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <box size="0.033 0.03 0.030" />
      </geometry>
      <material name="Red" />
    </visual>
  </link>
  <joint name="camera_joint" type="fixed">
    <origin xyz="0.21 0 0.13" rpy="0 0 0" />
    <parent link="racecar/chassis" />
    <child link="racecar/camera_link" />
    <axis xyz="0 0 1" />
  </joint>
  <link name="racecar/camera_optical_link">
    <inertial>
      <mass value="1e-5" />
      <origin xyz="0 0 0" rpy="0 0 0" />
      <inertia ixx="1e-6" ixy="0" ixz="0" iyy="1e-6" iyz="0" izz="1e-6" />
    </inertial>
  </link>
  <joint name="camera_optical_joint" type="fixed">
    <origin xyz="0 0.0 0" rpy="-1.570796327 0 -1.570796327" />
    <parent link="racecar/camera_link" />
    <child link="racecar/camera_optical_link" />
    <axis xyz="0 0 1" />
  </joint>
  <link name="racecar/imu_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <mass value="0.0000001" />
      <inertia ixx="1e-05" ixy="0.0" ixz="0.0" iyy="1e-05" iyz="0.0" izz="1e-05" />
    </inertial>
  </link>
  <joint name="imu_joint" type="fixed">
    <origin xyz="0.3 -0.115 0" rpy="0 0 0" />
    <parent link="racecar/base_link" />
    <child link="racecar/imu_link" />
  </joint>
  <gazebo reference="racecar/chassis">
    <mu1 value="0.0" />
    <mu2 value="0.0" />
    <kp value="10000000.0" />
    <kd value="1.0" />
    <material>
      <script>
        <uri>file://media/materials/scripts/gazebo.material</uri>
        <name>Gazebo/Blue</name>
      </script>
    </material>
  </gazebo>
  <gazebo reference="racecar/left_rear_wheel">
    <mu1 value="1.0" />
    <mu2 value="1.0" />
    <kp value="10000000.0" />
    <kd value="1.0" />
    <fdir1 value="1 0 0" />
    <material>
      <script>
        <uri>file://media/materials/scripts/gazebo.material</uri>
        <name>Gazebo/Black</name>
      </script>
    </material>
  </gazebo>
  <gazebo reference="racecar/right_rear_wheel">
    <mu1 value="1.0" />
    <mu2 value="1.0" />
    <kp value="10000000.0" />
    <kd value="1.0" />
    <fdir1 value="1 0 0" />
    <material>
      <script>
        <uri>file://media/materials/scripts/gazebo.material</uri>
        <name>Gazebo/Black</name>
      </script>
    </material>
  </gazebo>
  <gazebo reference="racecar/left_front_wheel">
    <mu1 value="1.0" />
    <mu2 value="1.0" />
    <kp value="10000000.0" />
    <kd value="1.0" />
    <fdir1 value="0 0 1" />
    <material>
      <script>
        <uri>file://media/materials/scripts/gazebo.material</uri>
        <name>Gazebo/Black</name>
      </script>
    </material>
  </gazebo>
  <gazebo reference="racecar/right_front_wheel">
    <mu1 value="1.0" />
    <mu2 value="1.0" />
    <kp value="10000000.0" />
    <kd value="1.0" />
    <fdir1 value="0 0 1" />
    <material>
      <script>
        <uri>file://media/materials/scripts/gazebo.material</uri>
        <name>Gazebo/Black</name>
      </script>
    </material>
  </gazebo>
  <gazebo>
    <plugin name="gz::sim::systems::AckermannSteering" filename="libgz-sim-ackermann-steering-system">
      <left_joint>left_front_wheel_joint</left_joint>
      <right_joint>right_front_wheel_joint</right_joint>
      <left_steering_joint>left_steering_hinge_joint</left_steering_joint>
      <right_steering_joint>right_steering_hinge_joint</right_steering_joint>
      <wheel_separation>0.25</wheel_separation>
      <kingpin_width>0.23</kingpin_width>
      <wheel_base>0.325</wheel_base>
      <wheel_radius>0.05</wheel_radius>
      <steering_limit>0.667</steering_limit>
      <topic>racecar/cmd_vel_to_gz</topic>
      <child_frame_id>racecar/base_footprint</child_frame_id>
      <publish_tf>false</publish_tf>
      <tf_topic>racecar/odom/tf</tf_topic>
      <odom_topic>racecar/odom</odom_topic>
    </plugin>
    <plugin filename="libgz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="libgz-sim-imu-system.so" name="gz::sim::systems::Imu">
      <topic>imu</topic>
      <imu_noise_density>0.0</imu_noise_density>
      <imu_random_walk>0.0</imu_random_walk>
      <orientation_noise_density>0.0</orientation_noise_density>
      <orientation_random_walk>0.0</orientation_random_walk>
      <gravity>0 0 -9.81</gravity>
      <initial_orientation_as_reference>false</initial_orientation_as_reference>
    </plugin>
    <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
      <gz_frame_id>odom</gz_frame_id>
      <topic>/joint_states</topic>
    </plugin>
  </gazebo>
  <gazebo reference="racecar/base_laser">
    <material>
      <script>
        <uri>file://media/materials/scripts/gazebo.material</uri>
        <name>Gazebo/DarkGrey</name>
      </script>
    </material>
    <sensor type="gpu_lidar" name="hokuyo_sensor">
      <pose>0 0 0.0124 0 0 0</pose>
      <topic>racecar/scan</topic>
      <visualize>false</visualize>
      <update_rate>10</update_rate>
      <ray>
        <scan>
          <horizontal>
            <samples>360</samples>
            <resolution>1</resolution>
            <min_angle>-3.12413907051</min_angle>
            <max_angle>3.14159274101</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.15</min>
          <max>12.0</max>
          <resolution>0.01</resolution>
        </range>
        <noise>
          <mean>0.0</mean>
          <stddev>0.01</stddev>
        </noise>
      </ray>
      <gz_frame_id>racecar/base_laser</gz_frame_id>
    </sensor>
  </gazebo>
  <gazebo reference="racecar/camera_link">
    <sensor type="camera" name="camera_sensor">
      <topic>racecar/camera</topic>
      <update_rate>10.0</update_rate>
      <horizontal_fov>1.5</horizontal_fov>
      <image>
        <width>160</width>
        <height>120</height>
        <format>B8G8R8</format>
      </image>
      <clip>
        <near>0.02</near>
        <far>300</far>
      </clip>
      <noise>
        <type>gaussian</type>
        <mean>0.0</mean>
        <stddev>0.007</stddev>
      </noise>
      <gz_frame_id>racecar/camera_optical_link</gz_frame_id>
    </sensor>
  </gazebo>
  <gazebo reference="racecar/imu_link">
    <sensor name="imu_sensor" type="imu">
      <gz_frame_id>racecar/imu_link</gz_frame_id>
      <topic>racecar/imu</topic>
    </sensor>
  </gazebo>
</robot>
